{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "qrg cleaning spec",
  "type": "object",
  "required": ["spec_version", "timezone", "hard_validation", "price_adjustment"],
  "properties": {
    "spec_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "timezone": { "type": "string", "minLength": 1 },
    "hard_validation": {
      "type": "object",
      "required": ["rules", "code_whitelist", "violation_rate_max", "violation_rate_fatal"],
      "properties": {
        "rules": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "code_whitelist": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "violation_rate_max": { "type": "number", "minimum": 0, "maximum": 1 },
        "violation_rate_fatal": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "price_adjustment": {
      "type": "object",
      "required": ["qfq_base_date"],
      "properties": {
        "qfq_base_date": { "type": "string", "format": "date" },
        "factor_definition": { "type": "string" },
        "reproduction_tolerance": { "type": "number", "minimum": 0 }
      }
    },
    "missing": { "type": "object" },
    "lookahead": { "type": "object" },
    "execution": { "type": "object" },
    "artifacts": { "type": "array", "items": { "type": "string" } }
  }
}
